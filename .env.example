# =========================================================
# Diabetes Food Safety Navigator
# Mode: Supabase 768 + Local EmbeddingGemma + Gemini Generation
# =========================================================


# =========================================================
# SUPABASE 768
# Table: guideline_chunks_768
# Vector dimension: 768
# =========================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# =========================================================
# LLM GENERATION
# Gemini is used only for final answer generation
# =========================================================
LLM_PROVIDER=gemini

GEMINI_GENERATION_API_KEY_0=
GEMINI_GENERATION_API_KEY_1=
GEMINI_GENERATION_API_KEY_2=
GEMINI_GENERATION_API_KEY_3=
GEMINI_GENERATION_API_KEY_4=

GEMINI_GENERATION_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_MAX_RETRIES_PER_KEY=1


# =========================================================
# EMBEDDINGS
# Documents are already embedded with EmbeddingGemma 768.
# User queries must also use EmbeddingGemma 768.
# =========================================================
EMBEDDING_PROVIDER=embeddinggemma
EMBEDDING_DIM=768

EMBEDDING_MODEL_NAME=google/embeddinggemma-300m

# Optional local Windows path if the model is downloaded locally.
# Use either EMBEDDING_MODEL_NAME or EMBEDDING_MODEL_PATH.
# Examples:
# EMBEDDING_MODEL_PATH=C:/Users/YourName/models/embeddinggemma-300m
# EMBEDDING_MODEL_PATH=C:\\Users\\YourName\\models\\embeddinggemma-300m
EMBEDDING_MODEL_PATH=


# =========================================================
# PROJECT SETTINGS
# =========================================================
PROJECT_TOPIC=diabetes_food_safety
DEFAULT_DISEASE_LAYER=diabetes

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
MIN_RETRIEVAL_CONFIDENCE=0.55


# =========================================================
# INGEST SETTINGS
# This ingest uses precomputed 768 embeddings.
# It must NOT call Gemini embeddings.
# =========================================================
PROCESSED_DATA_PATH=data/processed
CHUNKS_TABLE=guideline_chunks_768
MATCH_FUNCTION=match_guideline_chunks_768


# =========================================================
# BACKEND / CORS
# =========================================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501


# =========================================================
# FRONTEND
# Put this in frontend/.env, not root .env
# =========================================================
# VITE_API_BASE_URL=http://localhost:8000